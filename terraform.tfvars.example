# ============================================
# terraform.tfvars.example
# Copy this to terraform.tfvars and fill values
# NEVER commit terraform.tfvars to GitHub!
# ============================================

env                  = "prod"
instance_type        = "t3.micro"
asg_min_size         = 2
asg_max_size         = 6
asg_desired_capacity = 2
db_name              = "bookreviewdb"
db_username          = "your-db-username"   # change this
db_password          = "your-db-password"   # change this
alert_email          = "your@email.com"     # change this
